// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR_OFFICER
  PAYROLL_OFFICER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(10)
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")

  users        User[]
  attendance   Attendance[]
  leaveRequests LeaveRequest[]
  payslips     Payslip[]

  @@map("companies")
}

model User {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  firstName    String?  @db.VarChar(100) @map("first_name")
  lastName     String?  @db.VarChar(100) @map("last_name")
  name         String   @db.VarChar(255)
  loginId      String   @map("login_id") @db.VarChar(20)
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  joiningDate  DateTime @default(now()) @map("joining_date")
  basicSalary  Float?   @map("basic_salary")
  pfNumber     String?  @map("pf_number") @db.VarChar(50)
  mustChangePassword Boolean @default(true) @map("must_change_password")
  refreshToken String?  @map("refresh_token")
  forgotPasswordToken       String?   @map("forgot_password_token") @db.VarChar(255)
  forgotPasswordTokenExpiry DateTime? @map("forgot_password_token_expiry")
  createdAt    DateTime @default(now()) @map("created_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendance   Attendance[]
  leaveRequests LeaveRequest[]
  payslips     Payslip[]

  @@unique([companyId, loginId])
  @@unique([companyId, email])
  @@index([email])
  @@index([loginId])
  @@map("users")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  companyId Int              @map("company_id")
  userId    Int              @map("user_id")
  date      DateTime         @db.Date
  checkIn   DateTime?        @map("check_in")
  checkOut  DateTime?        @map("check_out")
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([companyId, date])
  @@map("attendance")
}

model LeaveRequest {
  id         Int         @id @default(autoincrement())
  companyId  Int         @map("company_id")
  userId     Int         @map("user_id")
  leaveType  String      @map("leave_type") @db.VarChar(50)
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  reason     String?
  status     LeaveStatus @default(PENDING)
  approvedBy Int?        @map("approved_by")
  createdAt  DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, userId])
  @@map("leave_requests")
}

model Payslip {
  id          Int       @id @default(autoincrement())
  companyId   Int       @map("company_id")
  userId      Int       @map("user_id")
  month       Int
  year        Int
  basicSalary Float     @map("basic_salary")
  deductions  Float     @default(0)
  netPay      Float     @map("net_pay")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([companyId, year, month])
  @@map("payslips")
}
