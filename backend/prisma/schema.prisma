generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR_OFFICER
  PAYROLL_OFFICER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Company {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  code          String   @unique @db.VarChar(10)
  logoUrl       String?  @map("logo_url")
  standardHours  Float    @default(8)       @map("standard_hours")
  workStartTime  String   @default("09:00") @map("work_start_time") @db.VarChar(5)
  workEndTime    String   @default("17:00") @map("work_end_time")   @db.VarChar(5)
  createdAt      DateTime @default(now())   @map("created_at")

  // Allowance percentages (applied to basic salary)
  hraPercent               Float @default(50)    @map("hra_percent")
  standardAllowancePercent Float @default(16.67) @map("standard_allowance_percent")
  performanceBonusPercent  Float @default(8.33)  @map("performance_bonus_percent")
  ltaPercent               Float @default(8.33)  @map("lta_percent")
  fixedAllowancePercent    Float @default(16.67) @map("fixed_allowance_percent")

  // Fixed monthly deductions
  professionalTaxAmount Float @default(200) @map("professional_tax_amount")

  users              User[]
  attendance         Attendance[]
  leaveRequests      LeaveRequest[]
  leaveAllocations   LeaveAllocation[]
  payslips           Payslip[]

  @@map("companies")
}

model User {
  id                        Int       @id @default(autoincrement())
  companyId                 Int       @map("company_id")
  firstName                 String?   @db.VarChar(100) @map("first_name")
  lastName                  String?   @db.VarChar(100) @map("last_name")
  name                      String    @db.VarChar(255)
  loginId                   String    @map("login_id") @db.VarChar(20)
  email                     String    @db.VarChar(255)
  passwordHash              String    @map("password_hash") @db.VarChar(255)
  role                      UserRole
  joiningDate               DateTime  @default(now()) @map("joining_date")
  basicSalary               Float?    @map("basic_salary")
  pfNumber                  String?   @map("pf_number") @db.VarChar(50)
  avatarUrl                 String?   @map("avatar_url")
  mobile                    String?   @db.VarChar(20)
  location                  String?   @db.VarChar(100)
  about                     String?   @db.Text
  jobPassion                String?   @db.Text @map("job_passion")
  interests                 String?   @db.Text
  monthlyWage               Float?    @map("monthly_wage")
  pfRate                    Float     @default(12) @map("pf_rate")
  workingDaysPerWeek        Int       @default(5) @map("working_days_per_week")
  breakTimeHours            Float     @default(1) @map("break_time_hours")
  // Job
  jobTitle                  String?   @db.VarChar(100) @map("job_title")
  managerId                 Int?      @map("manager_id")
  // Private Info
  dateOfBirth               DateTime? @db.Date @map("date_of_birth")
  address                   String?   @db.Text
  nationality               String?   @db.VarChar(100)
  personalEmail             String?   @db.VarChar(255) @map("personal_email")
  gender                    String?   @db.VarChar(20)
  maritalStatus             String?   @db.VarChar(20) @map("marital_status")
  // Bank Details
  bankAccountNumber         String?   @db.VarChar(50)  @map("bank_account_number")
  bankName                  String?   @db.VarChar(100) @map("bank_name")
  ifscCode                  String?   @db.VarChar(20)  @map("ifsc_code")
  panNumber                 String?   @db.VarChar(20)  @map("pan_number")
  uanNumber                 String?   @db.VarChar(30)  @map("uan_number")
  empCode                   String?   @db.VarChar(50)  @map("emp_code")
  mustChangePassword        Boolean   @default(true) @map("must_change_password")
  refreshToken              String?   @map("refresh_token")
  forgotPasswordToken       String?   @map("forgot_password_token") @db.VarChar(255)
  forgotPasswordTokenExpiry DateTime? @map("forgot_password_token_expiry")
  createdAt                 DateTime  @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager       User?          @relation("EmployeeManager", fields: [managerId], references: [id])
  reportees     User[]         @relation("EmployeeManager")
  attendance    Attendance[]
  leaveRequests LeaveRequest[]
  allocations   LeaveAllocation[] @relation("UserAllocations")
  createdAllocs LeaveAllocation[] @relation("AllocationCreator")
  payslips      Payslip[]
  skills        Skill[]
  certifications Certification[]

  @@unique([companyId, loginId])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@index([loginId])
  @@map("users")
}

model Skill {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Certification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  name       String    @db.VarChar(200)
  issuedBy   String?   @db.VarChar(200) @map("issued_by")
  issuedDate DateTime? @db.Date @map("issued_date")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model Attendance {
  id         Int              @id @default(autoincrement())
  companyId  Int              @map("company_id")
  userId     Int              @map("user_id")
  date       DateTime         @db.Date
  checkIn    DateTime?        @map("check_in")
  checkOut   DateTime?        @map("check_out")
  // computed and stored at checkout so list queries don't re-calculate
  workHours  Float?           @map("work_hours")
  extraHours Float?           @map("extra_hours")
  status     AttendanceStatus @default(PRESENT)
  createdAt  DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([companyId, date])
  @@map("attendance")
}

model LeaveRequest {
  id            Int         @id @default(autoincrement())
  companyId     Int         @map("company_id")
  userId        Int         @map("user_id")
  leaveType     String      @map("leave_type") @db.VarChar(50)
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  reason        String?
  status        LeaveStatus @default(PENDING)
  isPaid        Boolean     @default(true) @map("is_paid") // unpaid leave reduces payable days
  approvedBy    Int?        @map("approved_by")
  attachmentUrl String?     @map("attachment_url")         // Cloudinary URL for leave certificate/doc
  createdAt     DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, userId])
  @@map("leave_requests")
}

model LeaveAllocation {
  id          Int       @id @default(autoincrement())
  companyId   Int       @map("company_id")
  userId      Int       @map("user_id")
  leaveType   String    @map("leave_type") @db.VarChar(50)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date")   @db.Date        // null = no expiry
  days        Int                                          // allocated days
  note        String?
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation("UserAllocations",    fields: [userId],    references: [id])
  creator User    @relation("AllocationCreator",  fields: [createdBy], references: [id])

  @@index([companyId, userId])
  @@map("leave_allocations")
}

model Payslip {
  id               Int       @id @default(autoincrement())
  companyId        Int       @map("company_id")
  userId           Int       @map("user_id")
  month            Int
  year             Int

  // Prorated salary components
  basicSalary      Float     @map("basic_salary")
  hra              Float     @default(0)
  standardAllowance Float    @default(0) @map("standard_allowance")
  performanceBonus Float     @default(0) @map("performance_bonus")
  lta              Float     @default(0)
  fixedAllowance   Float     @default(0) @map("fixed_allowance")
  grossPay         Float     @map("gross_pay")

  // Deductions
  pfEmployee       Float     @default(0) @map("pf_employee")
  pfEmployer       Float     @default(0) @map("pf_employer")
  professionalTax  Float     @default(0) @map("professional_tax")
  tds              Float     @default(0)
  totalDeductions  Float     @default(0) @map("total_deductions")
  netPay           Float     @map("net_pay")

  // Employer total cost
  employerCost     Float     @default(0) @map("employer_cost")

  // Attendance summary for the month
  totalWorkingDays Int       @map("total_working_days")
  payableDays      Float     @map("payable_days")
  attendancePresent Int?     @map("attendance_present")
  attendanceHalf   Int?      @map("attendance_half")
  paidLeaveDays    Int?      @map("paid_leave_days")
  unpaidLeaveDays  Int?      @map("unpaid_leave_days")

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([companyId, year, month])
  @@map("payslips")
}
